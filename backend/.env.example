ENV=development
DEV_LOGIN_ENABLED=true   # local only: lets the frontend log in without Google
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
CLIENT_DOMAIN=http://localhost:3000

# Local dev: your own Postgres, created by backend/scripts/setup_local_db.sh
# Production (Supabase): session-mode pooler (5432) or direct connection, with sslmode=require
DATABASE_URL=postgresql+psycopg://db_owner:<password>@localhost:5432/creatorops
REDIS_URL=redis://localhost:6379/0

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

VIDEO_GEN_ENABLED=false
VIDEO_COST_PER_SECOND_USD=0   # set to your provider's price, or video generation stays blocked
IMAGE_GEN_ENABLED=false
YOUTUBE_API_KEY=
RESEND_API_KEY=
CLOUDINARY_URL=
