# Where the Next.js server proxies /api/* to (the FastAPI backend)
BACKEND_URL=http://127.0.0.1:8000   # 127.0.0.1, not localhost: Node may resolve localhost to IPv6, uvicorn listens on IPv4
# Shows an email-only login form on /login. Needs the backend's dev-login endpoint. Never in production.
NEXT_PUBLIC_DEV_LOGIN=true
